<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Batch Summary</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-5">
  <h1 class="mb-4">Staging batch loaded</h1>
  <p>These counts come from <code>workflow.staging_import</code>, not from the upload toast.</p>

  <% if (message) { %>
    <div class="alert alert-danger"><%= message %></div>
  <% } %>
  <% if (promoted) { %>
    <div class="alert alert-success">
      Appended <%= promoted %> new families to live <code>workflow.recipients</code> / <code>workflow.children</code>.
    </div>
  <% } %>

  <ul class="list-group mb-4">
    <li class="list-group-item"><strong>Batch ID:</strong> <%= summary.batch_id %></li>
    <li class="list-group-item"><strong>Families:</strong> <%= summary.family_count %></li>
    <li class="list-group-item"><strong>Children:</strong> <%= summary.child_count %></li>
    <li class="list-group-item"><strong>Valid rows:</strong> <%= summary.valid_count %></li>
    <li class="list-group-item"><strong>Invalid rows:</strong> <%= summary.invalid_count %></li>
    <li class="list-group-item"><strong>Imported at:</strong> <%= summary.imported_at %></li>
    <li class="list-group-item"><strong>Already in live DB:</strong> <%= overlap.length %></li>
  </ul>

  <% if (overlap.length) { %>
    <div class="alert alert-danger">
      Duplicate control numbers vs live <code>workflow.recipients</code>.
      Append is blocked until these are removed from staging (or you are looking at the wrong database).
    </div>
    <table class="table table-sm table-striped mb-4">
      <thead>
        <tr>
          <th>Control number</th>
          <th>Staging row</th>
          <th>Live status</th>
        </tr>
      </thead>
      <tbody>
        <% overlap.forEach(row => { %>
          <tr>
            <td><%= row.control_number %></td>
            <td><%= row.row_number %></td>
            <td><%= row.live_status %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="text-success">No control numbers in this batch already exist in <code>workflow.recipients</code>.</p>
    <form action="/batch/<%= summary.batch_id %>/promote" method="post" class="mb-4"
          onsubmit="return confirm('Backup taken? This will insert <%= summary.family_count %> new families into live tables.');">
      <button type="submit" class="btn btn-primary">Append new families to live</button>
    </form>
  <% } %>

  <a href="/" class="btn btn-secondary">Import another file</a>
</body>
</html>
