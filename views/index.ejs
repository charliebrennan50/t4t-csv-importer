<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CSV Importer</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-5">
  <h1 class="mb-2">T4T CSV Importer</h1>
  <p class="text-muted">Validate the whole file first. Staging is written only when every row is clean.</p>

  <% if (message) { %>
    <div class="alert <%= blocked ? 'alert-danger' : 'alert-info' %>"><%= message %></div>
  <% } %>

  <form action="/import" method="post" enctype="multipart/form-data" class="mb-4">
    <input type="file" name="csv" accept=".csv" class="form-control mb-2" required>
    <button type="submit" class="btn btn-primary">Validate and load staging</button>
  </form>

  <% if (report && report.length) { %>
    <h3>Validation report</h3>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Row</th>
          <th>Status</th>
          <th>Control Number</th>
          <th>Error</th>
        </tr>
      </thead>
      <tbody>
        <% report.forEach(r => { %>
          <tr class="<%= r.status === 'error' ? 'table-danger' : '' %>">
            <td><%= r.row_number %></td>
            <td><%= r.status %></td>
            <td><%= r.control_number || '' %></td>
            <td><%= r.error || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
